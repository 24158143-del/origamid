<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Healthy Vending</title>
  <link rel="stylesheet" href="style.css" />
</head>
<body>
  <header>
    <h1>Healthy Vending Machine</h1>
    <p>Fresh juices & nutritious snacks at your fingertips</p>
  </header>

  <section class="products">
    <h2>Choose Your Refreshment</h2>
    <div class="grid">
      <div class="item">
        <img src="https://via.placeholder.com/150?text=Green+Juice" alt="Green Juice" />
        <h3>Green Juice</h3>
        <p>₹80</p>
        <button onclick="purchase('Green Juice')">Buy</button>
      </div>
      <div class="item">
        <img src="https://via.placeholder.com/150?text=Fruit+Mix" alt="Fruit Mix" />
        <h3>Fruit Mix</h3>
        <p>₹90</p>
        <button onclick="purchase('Fruit Mix')">Buy</button>
      </div>
      <div class="item">
        <img src="https://via.placeholder.com/150?text=Protein+Bar" alt="Protein Bar" />
        <h3>Protein Bar</h3>
        <p>₹60</p>
        <button onclick="purchase('Protein Bar')">Buy</button>
      </div>
    </div>
  </section>

  <footer>
    <p>&copy; 2025 Healthy Vending Co.</p>
  </footer>

  <script src="script.js"></script>
</body>
</html>
body {
  font-family: 'Segoe UI', sans-serif;
  margin: 0;
  background: #f0fff0;
  color: #333;
}

header {
  background: #4caf50;
  color: white;
  padding: 2rem;
  text-align: center;
}

.products {
  padding: 2rem;
  text-align: center;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 2rem;
}

.item {
  background: white;
  border-radius: 10px;
  box-shadow: 0 0 10px #ccc;
  padding: 1rem;
  width: 200px;
}

.item img {
  width: 100%;
  border-radius: 10px;
}

button {
  background: #4caf50;
  color: white;
  border: none;
  padding: 0.5rem 1rem;
  margin-top: 0.5rem;
  cursor: pointer;
  border-radius: 5px;
}

button:hover {
  background: #388e3c;
}

footer {
  text-align: center;
  padding: 1rem;
  background: #e0f2f1;
}
function purchase(item) {
  alert(`You selected: ${item}. Thank you for choosing healthy!`);
}
